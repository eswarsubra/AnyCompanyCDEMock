# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build / IaC artifacts
dist/
build/
cdk.out/
*.tfstate
*.tfstate.*
.terraform/

# Secrets & local config — NEVER commit credentials
.env
.env.*
*.pem
*.key
aws.json
credentials

# Editor / OS / local tooling
.DS_Store
.idea/
.vscode/
*.log
.claude/

# Security & quality scan output — evidence is attached to SIM, not committed.
# The ASH config (.ash/.ash.yaml) IS committed: it records the justified
# scanner suppressions and keeps the gate reproducible.
.ash/*
!.ash/.ash.yaml
.protoshield/
.holmes/

# Working / planning notes — generated for our own use, NOT part of the
# deliverable. Committed docs live in docs/ and README.md; scratch planning,
# roadmaps, and working write-ups go here and are never committed.
planning/

# CDK deploy outputs (resource ids/URLs) — regenerated per deploy, not source.
cdk-outputs.json
