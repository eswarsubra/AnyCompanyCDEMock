{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anycompany-apparel/review-pipeline/review.schema.json",
  "title": "AnyCompany Apparel — Review dataset",
  "description": "Schema for the synthetic customer-review dataset consumed by the pipeline. All data is synthetic and MUST contain no PII.",
  "type": "object",
  "required": ["schema_version", "generated_at", "reviews"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semantic version of this dataset schema.",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the dataset was generated (UTC)."
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "review_id",
        "product_id",
        "product_name",
        "source_language",
        "rating",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "type": "string",
          "description": "Stable unique id for the review.",
          "pattern": "^rev-[0-9]{4}$"
        },
        "product_id": {
          "type": "string",
          "description": "Product this review is about.",
          "pattern": "^prod-[0-9]{3}$"
        },
        "product_name": {
          "type": "string",
          "description": "Human-readable product name (in English; the catalog is English).",
          "minLength": 1
        },
        "source_language": {
          "type": "string",
          "description": "ISO 639-1 code of the language the review body is written in.",
          "enum": ["en", "fr", "de", "es", "it", "pt"]
        },
        "rating": {
          "type": "integer",
          "description": "Star rating, 1-5.",
          "minimum": 1,
          "maximum": 5
        },
        "title": {
          "type": "string",
          "description": "Short review title, in source_language.",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "description": "Review text, in source_language. Synthetic, no PII.",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
